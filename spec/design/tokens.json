{
  "name": "DotRec design tokens",
  "version": "1.0.0",
  "color": {
    "dark": {
      "bg": "#000000",
      "surface": "#151515",
      "surfaceRaised": "#1F1F1F",
      "line": "#2B2B2B",
      "fg": "#FFFFFF",
      "fgMuted": "#8C8C8C",
      "onFg": "#000000",
      "record": "#D71921"
    },
    "light": {
      "bg": "#F1F1F1",
      "surface": "#FFFFFF",
      "surfaceRaised": "#FFFFFF",
      "line": "#DCDCDC",
      "fg": "#101010",
      "fgMuted": "#6B6B6B",
      "onFg": "#FFFFFF",
      "record": "#D71921"
    }
  },
  "radius": { "chip": 12, "card": 20, "tile": 28, "pill": 999 },
  "spacing": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32 },
  "stroke": { "hairline": 0.5, "ring": 2 },
  "size": {
    "recordButton": 120,
    "recordInner": 72,
    "recordStop": 44,
    "touchMin": 48,
    "icon": 24
  },
  "type": {
    "dotFamily": "Doto",
    "dotUse": ["timer", "status", "numeric values", "screen titles"],
    "bodyFamily": "system",
    "scale": {
      "display": { "size": 44, "weight": 700, "font": "dot" },
      "title": { "size": 22, "weight": 700, "font": "dot" },
      "value": { "size": 16, "weight": 700, "font": "dot" },
      "body": { "size": 16, "weight": 400, "font": "body" },
      "label": { "size": 13, "weight": 500, "font": "body" },
      "caption": { "size": 12, "weight": 400, "font": "body" }
    }
  },
  "motion": {
    "recordMorphMs": 220,
    "pulseMs": 2000,
    "chipSelectMs": 120,
    "curve": "easeOutCubic",
    "respectDisableAnimations": true
  },
  "presets": {
    "fast": { "label": "Быстро", "resolution": 720, "fps": 30, "bitrateMbps": 6 },
    "balanced": { "label": "Баланс", "resolution": 1080, "fps": 60, "bitrateMbps": 20 },
    "quality": { "label": "Качество", "resolution": 1440, "fps": 60, "bitrateMbps": 40 }
  }
}
